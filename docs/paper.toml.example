[lean]
project = "lean"
modules = []
source = ""
source_name = ""
# Where one declaration's lines can be read, when the artifact has such a link:
# source_lines = "https://github.com/owner/repo/blob/COMMIT/{path}#L{line}-L{end}"
licence = ""
scope = ""

# The reading copy. Delete this part until the paper has a paper.md.
[reading]
language = "haskell"          # the language of the paper's code listings
page_label = "{page}"         # how the paper numbers its pages, such as "191:{page}"

# Plots stay the authors' own: each is cut from the PDF as vector artwork, and the
# words inside it are left out of the text comparison. The box is in PDF points.
